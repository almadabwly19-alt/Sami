package com.bahith.pdf

import android.net.Uri
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import org.json.JSONObject
import java.io.File
import java.net.HttpURLConnection
import java.net.URL

data class ShamelBookItem(
    val id: String,
    val title: String,
    val author: String,
    val category: String,
    val downloadUrl: String
)

object ShamelLibraryAPI {
    suspend fun search(query: String): List<ShamelBookItem> = withContext(Dispatchers.IO) {
        val encoded = Uri.encode(query)
        val url = "https://shamela.ws/api/v1/search?q=$encoded"
        val connection = (URL(url).openConnection() as HttpURLConnection).apply {
            connectTimeout = 15000
            readTimeout = 30000
            requestMethod = "GET"
            setRequestProperty("User-Agent", "BahithPDF/2.0 (Android Shamel Integration)")
        }
        try {
            val code = connection.responseCode
            if (code !in 200..299) return@withContext emptyList()
            val body = connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText() }
            val root = JSONObject(body)
            val items = root.optJSONArray("data") ?: return@withContext emptyList()
            buildList {
                for (i in 0 until items.length()) {
                    val obj = items.optJSONObject(i) ?: continue
                    add(ShamelBookItem(
                        id = obj.optString("id"),
                        title = obj.optString("title"),
                        author = obj.optString("author", "غير معروف"),
                        category = obj.optString("category", "عام"),
                        downloadUrl = obj.optString("download_url")
                    ))
                }
            }
        } catch (e: Exception) {
            emptyList()
        } finally {
            connection.disconnect()
        }
    }

    suspend fun downloadBook(item: ShamelBookItem, onProgress: (Int) -> Unit): File = withContext(Dispatchers.IO) {
        val connection = (URL(item.downloadUrl).openConnection() as HttpURLConnection).apply {
            connectTimeout = 20000
            readTimeout = 60000
            setRequestProperty("User-Agent", "BahithPDF/2.0 (Android)")
        }
        val out = File.createTempFile("shamel_", ".pdf")
        try {
            val code = connection.responseCode
            if (code !in 200..299) throw IllegalStateException("خطأ في الاتصال بالتحميل: HTTP $code")
            val total = connection.contentLengthLong
            connection.inputStream.use { input ->
                out.outputStream().buffered().use { output ->
                    val buffer = ByteArray(64 * 1024)
                    var count: Int
                    var received = 0L
                    while (input.read(buffer).also { count = it } >= 0) {
                        if (count == 0) continue
                        output.write(buffer, 0, count)
                        received += count
                        if (total > 0) onProgress(((received * 100) / total).toInt().coerceIn(0, 99))
                    }
                }
            }
            onProgress(100)
            out
        } catch (e: Exception) {
            out.delete()
            throw e
        } finally {
            connection.disconnect()
        }
    }
}
__EOF__

